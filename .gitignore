# Logs (regenerated at runtime, not config)
*.log
logs/

# Caches
.cache/
cache/
Cache/
*.cache

# OBS Studio runtime/profiling data and plugin registry — regenerated
# automatically, not authored config
obs-studio/logs/
obs-studio/profiler_data/
obs-studio/plugin_manager/

# OBS websocket plugin stores its remote-control password in plaintext here
obs-studio/plugin_config/obs-websocket/config.json

# Lockfiles / transient runtime state
*.lock
lockfile
.sentinel
queue.sqlite3

# Editor/OS backup junk
*.bak
*~
*.swp
.DS_Store

# Upstream 43PR/dotfiles clone, if one is ever pulled down locally again. It
# carries its own .git, so committing it would nest a repo.
dotfiles/

# Python bytecode, produced by running the scripts in hypr/scripts
__pycache__/
*.pyc

# VLC's Qt interface state: window geometry, and a recently-played list that
# leaks file paths from $HOME. vlcrc holds the actual settings; this is runtime.
vlc/vlc-qt-interface.conf

# Calendar feed URLs are bearer secrets and live in ~/.config/gelo/, outside
# this repo. Belt and braces in case that ever moves.
calendars.json

