{
  "$description": "Generated from design/tokens.json \u2014 the single source for a Hyprland desktop, its terminal, editor, login screen and Spotify. Edit the source, not this file.",
  "color": {
    "$description": "Light XMB. Zero warm hues; the absence of orange and amber is load-bearing.",
    "bg-0": {
      "$type": "color",
      "$value": "#eef1f8"
    },
    "bg-1": {
      "$type": "color",
      "$value": "#f8fbff"
    },
    "bg-2": {
      "$type": "color",
      "$value": "#dceaf8"
    },
    "border": {
      "$type": "color",
      "$value": "#bed7eb"
    },
    "text-1": {
      "$type": "color",
      "$value": "#1b4c78"
    },
    "text-2": {
      "$type": "color",
      "$value": "#5a7fb5"
    },
    "accent": {
      "$type": "color",
      "$value": "#3478c4",
      "$description": "The one accent. Appears in exactly three places system-wide: active workspace, focused window border, cursor. A fourth is a redesign."
    },
    "accent-dim": {
      "$type": "color",
      "$value": "#2e68a8"
    },
    "glow": {
      "$type": "color",
      "$value": "#4a8cd033",
      "$description": "The accent at low alpha. Selection blooms rather than filling."
    },
    "shade": {
      "$type": "color",
      "$value": "#1f466b",
      "$description": "Shadows and scrims are built from this, never from bg-0 \u2014 on a light palette bg-0 is the lightest surface, so shadows made from it vanish."
    },
    "accent-ink": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "What sits ON the accent. Not named `on-accent`: that camel-cases to `onAccent`, which QML parses as a signal handler."
    },
    "field-base": {
      "$type": "color",
      "$value": "#7cb8e8"
    },
    "field-mid": {
      "$type": "color",
      "$value": "#a8d3f2"
    },
    "field-high": {
      "$type": "color",
      "$value": "#eef1f8"
    },
    "field-edge": {
      "$type": "color",
      "$value": "#edf6ff"
    },
    "field-line": {
      "$type": "color",
      "$value": "#e6f4ff"
    }
  },
  "space": {
    "$description": "Strict 4px grid.",
    "xs": {
      "$type": "dimension",
      "$value": "4px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "8px"
    },
    "md": {
      "$type": "dimension",
      "$value": "12px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "16px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "24px"
    },
    "xxl": {
      "$type": "dimension",
      "$value": "32px"
    }
  },
  "radius": {
    "$description": "Chrome uses 8 \u2014 the XMB material is more angular than glass.",
    "sm": {
      "$type": "dimension",
      "$value": "8px"
    },
    "md": {
      "$type": "dimension",
      "$value": "12px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "16px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "24px"
    },
    "full": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "type": {
    "$description": "Geist, one family. Weight never exceeds 400: hierarchy comes from size, opacity, tracking and glow.",
    "family": {
      "$type": "fontFamily",
      "$value": [
        "Geist",
        "Inter Display"
      ]
    },
    "size": {
      "caption": {
        "$type": "dimension",
        "$value": "11px"
      },
      "body": {
        "$type": "dimension",
        "$value": "13px"
      },
      "title": {
        "$type": "dimension",
        "$value": "15px"
      }
    },
    "weight": {
      "light": {
        "$type": "fontWeight",
        "$value": 300
      },
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      }
    },
    "tracking": {
      "$type": "number",
      "$value": 0.02
    }
  },
  "motion": {
    "$description": "One curve, shared by the shell, the compositor and the lock screen.",
    "ease": {
      "$type": "cubicBezier",
      "$value": [
        0.22,
        1.0,
        0.36,
        1.0
      ]
    },
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "150ms"
      },
      "base": {
        "$type": "duration",
        "$value": "250ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "400ms"
      }
    },
    "stagger": {
      "$type": "duration",
      "$value": "24ms"
    }
  },
  "terminal": {
